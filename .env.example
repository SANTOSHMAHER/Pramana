# Data paths may be relative to this project folder or absolute Windows paths.
GARI_FAQ_DATA_PATH=database/test.json
GARI_LOCAL_DATA_PATH=database/data_address.json

# Local Ollama endpoint and installed model names.
GARI_OLLAMA_URL=http://127.0.0.1:11434
GARI_CHAT_MODEL=qwen2.5:1.5b
GARI_EMBEDDING_MODEL=all-minilm
GARI_OLLAMA_TIMEOUT=120

# Web server settings.
GARI_HOST=127.0.0.1
GARI_PORT=5001

# Assistant identity.
GARI_BOT_NAME=Pramana
GARI_BOT_TAGLINE=Evidence-grounded local AI
