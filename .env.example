# Data paths may be relative to this project folder or absolute Windows paths.
PRAMANA_FAQ_DATA_PATH=database/test.json
PRAMANA_LOCAL_DATA_PATH=database/data_address.json

# Local Ollama endpoint and installed model names.
PRAMANA_OLLAMA_URL=http://127.0.0.1:11434
PRAMANA_CHAT_MODEL=qwen2.5:1.5b
PRAMANA_EMBEDDING_MODEL=all-minilm
PRAMANA_OLLAMA_TIMEOUT=120

# Web server settings.
PRAMANA_HOST=127.0.0.1
PRAMANA_PORT=5001

# Assistant identity.
PRAMANA_BOT_NAME=Pramana
PRAMANA_BOT_TAGLINE=Evidence-grounded local AI
PRAMANA_DEFAULT_PROVIDER=ollama

# Configure API keys only if you want to use Gemini or OpenAI.
# Retrieved document excerpts are sent to the selected online provider.
PRAMANA_GEMINI_API_KEY=
PRAMANA_GEMINI_MODEL=gemini-2.5-flash
PRAMANA_OPENAI_API_KEY=
PRAMANA_OPENAI_MODEL=gpt-4.1-mini

# Persistent FAISS vectors and uploaded-document metadata stay local.
PRAMANA_VECTOR_INDEX_DIR=.pramana/index
